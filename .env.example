DJANGO_SETTINGS_MODULE=config.settings.local

SECRET_KEY=dev_edu_secret_key
DEBUG=False

ALLOWED_HOSTS=127.0.0.1,localhost
ENVIRONMENT=development

# CORS / CSRF
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000

DB_NAME=dev_edu_db
DB_USER=db_admin
DB_PASSWORD=strong_password
DB_HOST=db
DB_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=5

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=example@mail.com
EMAIL_HOST_PASSWORD=email_password